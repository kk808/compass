{
  "openapi": "3.0.3",
  "info": {
    "title": "Compass Tasks API",
    "version": "1.0.0",
    "description": "Learning API. POST validates input and echoes the title; tasks are not saved."
  },
  "servers": [
    {
      "url": "./"
    }
  ],
  "paths": {
    "/api/tasks": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "List tasks",
        "responses": {
          "200": {
            "description": "Task list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Tasks"
        ],
        "summary": "Submit a task",
        "description": "Validates the JSON body. Returns the title without saving a task.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "description"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "examples": {
                "valid": {
                  "summary": "Valid task",
                  "value": {
                    "title": "Learn PHP",
                    "description": "Practice creating tasks"
                  }
                },
                "invalid": {
                  "summary": "Missing required values (422)",
                  "value": {
                    "title": "",
                    "description": ""
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation succeeded (task is not persisted)",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "data": {
                    "title": "Learn PHP"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "example": {
                  "status": "error",
                  "errors": {
                    "title": "The title field is required.",
                    "description": "The description field is required."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{id}": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "Get a task by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Task found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "404": {
            "description": "Task not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Learn PHP basics"
          },
          "done": {
            "type": "boolean",
            "example": false
          }
        }
      }
    }
  }
}
